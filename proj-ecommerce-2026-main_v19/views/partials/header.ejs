<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/estilo.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=New+Amsterdam&display=swap" rel="stylesheet">
    <title>Document</title>
</head>

<body class="body min-vh-100">
    <div class="header-style">
        <img src="/uploads/logo.png" class="logo-header">
        <input class="pesquisa-header" type="text" placeholder="Pesquise" onfocus="this.placeholder=''" onblur="this.placeholder='Pesquise'">
        <a href="">
            <img src="/uploads/carrinho.png" alt="" class="header-cart">
        </a>
        <a href="">
            <img src="/uploads/perfil.png" alt="" class="header-profile">
        </a>
    </div>    
    <ul class="categorias">
        <%
            categorias.forEach(categoria => {
        %>
            <li><a href="" class="categoria-item"><%=categoria.nome%></a></li>
        <%
            });
        %>

    </ul>